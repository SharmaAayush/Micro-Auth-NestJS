# Port on which the server will run
PORT=3000

# Domain for setting cookies (including refresh token cookie)
# For development, you can leave this as .domain.com or set to your actual domain
DOMAIN=.domain.com

# Secret key used to sign JWT tokens
# In production, this should be a strong, randomly generated secret
JWT_SECRET=your-secret-key

# Expiration duration for access tokens (e.g., 15m, 1h, 24h)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Expiration duration for refresh tokens (e.g., 7d, 30d)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_DATABASE=your_database_name

# DANGER: synchronize alters the database schema to match the entities on boot.
# Leave false in any environment with real data. Enable only on ephemeral
# dev databases where you do not want to run migrations.
DB_SYNCHRONIZE=false

# TypeORM SQL logging. true / false.
DB_LOGGING=false

# Set to `true` to serve the interactive Swagger UI at /api/docs. Leave
# unset or `false` in production builds so the docs route is not exposed.
ENABLE_API_DOCS=true
